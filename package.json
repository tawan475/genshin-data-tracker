{
  "name": "genshin-data-tracker",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gdt/tracker dev",
    "build": "pnpm --filter @gdt/tracker build",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write \"apps/*/src/**/*.{ts,vue}\" \"apps/*/worker/**/*.ts\" \"packages/*/src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
