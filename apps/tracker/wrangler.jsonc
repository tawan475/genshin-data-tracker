{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genshin-data-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "routes": [{ "pattern": "genshin-tracker.475.dev", "custom_domain": true }],
  "workers_dev": false,

  // Run the Worker next to D1 rather than at the visitor's edge. Measured from
  // Bangkok, each D1 round trip cost ~120 ms of network while SQL took ~5 ms,
  // and an import makes 2-3 of them. Static assets are still served from the
  // edge; only /api requests run in the placed Worker.
  "placement": { "mode": "smart" },

  // The Vue app is served as static assets; only /api/* reaches the Worker.
  // Unknown paths fall back to index.html for client-side routing.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Created with: wrangler d1 create gdt --location apac (2026-10-04).
  // Local dev and tests use a local SQLite file instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdt",
      "database_id": "d64c20e3-2bca-4333-9966-bd79627d4f15",
      "migrations_dir": "migrations",
    },
  ],

  // Live updates (worker/services/live.ts): one LiveHub per user holds that
  // user's open tabs' WebSockets (hibernating while idle) and fans out every
  // change. SQLite-backed, as the Free plan requires; it stores nothing.
  // `wrangler deploy` applies the migration; there is no D1 change.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  // Per-isolate-group request limits (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "IMPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Requests that can send email (forgot password per IP, confirmations per user).
    { "name": "RECOVERY_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
  ],

  // Secrets (wrangler secret put): JWT_SECRET, PASSWORD_PEPPER — each at least
  // 32 random characters. Local dev reads them from .dev.vars.
  // Optional (worker/lib/oauth.ts): DISCORD_CLIENT_ID + DISCORD_CLIENT_SECRET
  // and GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET turn on "Continue with
  // Discord / Google"; a provider without both stays off and hidden (README,
  // "Sign in with Discord / Google"). `vite dev` uses a fake provider instead.

  // Email (worker/lib/email.ts): confirmation and reset links go out through
  // Cloudflare Email Service, a `send_email` binding named EMAIL. It stays out
  // of this file until 475.dev is onboarded to Email Sending (README, "Account
  // recovery"); without it nothing is sent and the app says email is not
  // available. Then add:
  //   "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@475.dev"] }],
  // `vite dev` simulates it (vite.config.ts). Optional vars: EMAIL_FROM
  // (default no-reply@475.dev) and SITE_URL (the origin links point at,
  // default https://genshin-tracker.475.dev).
  // The email features are paused unless the var EMAIL_FEATURES is "1": no
  // email field, no "forgot password", no mail even with the binding; admin
  // reset links still work. To turn them on, add with the binding:
  //   "vars": { "EMAIL_FEATURES": "1" },

  // Daily housekeeping (worker/services/maintenance.ts), 02:23 in Bangkok.
  "triggers": { "crons": ["23 19 * * *"] },

  "observability": { "enabled": true },
}
