{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genshin-data-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  "routes": [{ "pattern": "genshin-tracker.475.dev", "custom_domain": true }],
  "workers_dev": false,

  // The Vue app is served as static assets; only /api/* reaches the Worker.
  // Unknown paths fall back to index.html for client-side routing.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Created with: wrangler d1 create gdt --location apac (2026-10-04).
  // Local dev and tests use a local SQLite file instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdt",
      "database_id": "d64c20e3-2bca-4333-9966-bd79627d4f15",
      "migrations_dir": "migrations",
    },
  ],

  // Per-isolate-group request limits (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "IMPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
  ],

  // Secrets (wrangler secret put): JWT_SECRET, PASSWORD_PEPPER — each at least
  // 32 random characters. Local dev reads them from .dev.vars.

  "observability": { "enabled": true },
}
