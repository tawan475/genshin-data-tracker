{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker keeps its first name (the repo is teyvat.me-tracker now):
  // renaming it would make a new Worker without its secrets and Durable Objects.
  "name": "genshin-data-tracker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-22",
  // teyvat.me is the site. genshin-tracker.475.dev, its old address, stays:
  // installed irminsul copies post to its /api, and index.html sends its
  // pages on to teyvat.me.
  "routes": [
    { "pattern": "teyvat.me", "custom_domain": true },
    { "pattern": "genshin-tracker.475.dev", "custom_domain": true },
  ],
  "workers_dev": false,

  // No placement: the Worker runs at the visitor's edge, so with D1 read
  // replication on (both databases) reads are answered by the nearest replica
  // (worker/lib/d1-session.ts). Until 2026-10-26 it was pinned next to the
  // primaries ("targeted", aws:ap-northeast-3: `gdt` is in KIX, `gdt-live` in
  // HKG), which made each D1 round trip ~5 ms instead of ~120 ms from Bangkok
  // but sent every read in the world to Osaka. Writes still go to the primary:
  // an import's 2-3 round trips cost the distance to it.

  // The Vue app is served as static assets; only /api/* reaches the Worker,
  // and /landing/* (the demo videos need byte ranges: worker/lib/byte-range.ts).
  // Unknown paths fall back to index.html for client-side routing.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/landing/*"],
  },

  // Created with: wrangler d1 create gdt --location apac (2026-10-04).
  // Local dev and tests use a local SQLite file instead.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdt",
      "database_id": "d64c20e3-2bca-4333-9966-bd79627d4f15",
      "migrations_dir": "migrations",
    },
    // Live sync (docs/plans/live-sync.md): journals, batches and chart
    // points, kept apart from `gdt` by purpose. Created with: wrangler d1
    // create gdt-live --location apac (2026-10-15). Its own migrations:
    // `pnpm db:migrate:live:local|remote` (deploy.yml runs the remote one).
    {
      "binding": "LIVE_DB",
      "database_name": "gdt-live",
      "database_id": "12c947eb-37c5-4d6c-bb57-eaace7a792c3",
      "migrations_dir": "migrations-live",
    },
  ],

  // Live updates (worker/services/live.ts): one LiveHub per user holds that
  // user's open tabs' WebSockets (hibernating while idle) and fans out every
  // change. SQLite-backed, as the Free plan requires; it stores nothing.
  // `wrangler deploy` applies the migration; there is no D1 change.
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  // Per-isolate-group request limits (period must be 10 or 60 seconds).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Website uploads per account, and import key checks (verify-key) per key.
    { "name": "IMPORT_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    // Requests that can send email (forgot password per IP, confirmations per user).
    { "name": "RECOVERY_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    // Uploads by import key (irminsul), per key.
    { "name": "KEY_IMPORT_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
    // Wish link imports: pages fetched through the proxy, per user (a second apart each).
    { "name": "WISH_PROXY_LIMITER", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
    // Live sync batches from irminsul (POST /api/irminsul/changes), per key or session.
    { "name": "LIVE_LIMITER", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
  ],

  // Secrets (wrangler secret put): JWT_SECRET, PASSWORD_PEPPER — each at least
  // 32 random characters. Local dev reads them from .dev.vars.
  // Optional (worker/lib/oauth.ts): DISCORD_CLIENT_ID + DISCORD_CLIENT_SECRET
  // and GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET turn on "Continue with
  // Discord / Google"; a provider without both stays off and hidden (README,
  // "Sign in with Discord / Google"). `vite dev` uses a fake provider instead.
  // Optional (worker/lib/turnstile.ts): TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY
  // turn on the human check on sign-up and sign-in; with one only it stays off
  // (README, "Human check"). `vite dev` uses Cloudflare's test keys.

  // Email (worker/lib/email.ts): confirmation and reset links go out through
  // Cloudflare Email Service, a `send_email` binding named EMAIL. It stays out
  // of this file until 475.dev is onboarded to Email Sending (README, "Account
  // recovery"); without it nothing is sent and the app says email is not
  // available. Then add:
  //   "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@475.dev"] }],
  // `vite dev` simulates it (vite.config.ts). Optional vars: EMAIL_FROM
  // (default no-reply@475.dev) and SITE_URL (the origin links point at,
  // default https://teyvat.me).
  // The email features are paused unless the var EMAIL_FEATURES is "1": no
  // email field, no "forgot password", no mail even with the binding; admin
  // reset links still work. To turn them on, add with the binding:
  //   "vars": { "EMAIL_FEATURES": "1" },

  // Daily housekeeping (worker/services/maintenance.ts), 02:23 in Bangkok;
  // hourly at :07 the game's events (worker/services/game-events.ts).
  "triggers": { "crons": ["23 19 * * *", "7 * * * *"] },

  "observability": { "enabled": true },
}
